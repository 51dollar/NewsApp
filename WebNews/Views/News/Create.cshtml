@model WebNews.Models.News

@{
    ViewData["Title"] = "Create Post";
}

<div class="content-wrapper">
    <div class="d-flex justify-content-center">
        <h2>@ViewData["Title"]</h2>
    </div>


    <form asp-action="Create" asp-controller="News" method="post" enctype="multipart/form-data" class="mt-4">
        <div>
            <label asp-for="Title" class="fs-4"></label>
            <input asp-for="Title" class="form-control"/>
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Subtitle" class="fs-4"></label>
            <input asp-for="Subtitle" class="form-control"/>
            <span asp-validation-for="Subtitle" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Author" class="fs-4"></label>
            <input asp-for="Author" class="form-control"/>
            <span asp-validation-for="Author" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Content" class="fs-4"></label>
            <textarea asp-for="Content" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Image" class="fs-4"></label>
            <input asp-for="Image" type="file" class="form-control"/>
        </div>
        <div class="d-flex justify-content-center gap-2 mt-4">
            <button type="submit" class="btn btn-primary mt-1">Publish News</button>
            <a asp-action="Index" class="btn btn-secondary mt-1">Back to Page</a>
        </div>
    </form>
</div>