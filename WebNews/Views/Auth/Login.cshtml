@model WebNews.Models.ViewModels.UserViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg p-4 rounded-4">
                <h2 class="text-center mb-4">Sign In</h2>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-action="Login" method="post" novalidate>
                    <div class="mb-3">
                        <label asp-for="User.Email" class="form-label"></label>
                        <input asp-for="User.Email" class="form-control" placeholder="Enter your email"/>
                        <span asp-validation-for="User.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="User.PasswordHash" class="form-label">Password</label>
                        <input asp-for="User.PasswordHash" type="password" class="form-control"
                               placeholder="Enter your password"/>
                        <span asp-validation-for="User.PasswordHash" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg rounded-3">Login</button>
                    </div>

                    <div class="text-center mt-3">
                        <small>Don't have an account? <a asp-action="Register">Register now</a></small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}