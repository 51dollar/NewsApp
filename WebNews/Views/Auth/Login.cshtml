@model WebNews.Models.ViewModels.Auth.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="content-wrapper container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg p-4 rounded-4">
                <h2 class="text-center mb-2">Sign In</h2>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger rounded-3">@ViewBag.Error</div>
                }

                <form asp-action="Login" asp-controller="Auth" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control rounded-3" placeholder="Enter your email"/>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="password" class="form-control rounded-3"
                               placeholder="Enter your password"/>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div>
                        <label class="form-check-label">
                            <input asp-for="RememberMe" class="form-check-input"/>
                            @Html.DisplayNameFor(a => a.RememberMe)
                        </label>
                    </div>
                    
                    <div class="d-flex justify-content-center">
                        <button type="submit" class="btn btn-success rounded-3">Login</button>
                    </div>

                    <div class="text-center mt-2">
                        <small>Don't have an account? <a asp-action="Register">Register now</a></small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}