@model WebNews.Models.ViewModels.Account.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="content-wrapper container mt-5" style="width:70%">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-light shadow-lg p-4 rounded-4">
                <form asp-action="UpdatePassword" asp-controller="Account" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger rounded-3">@ViewBag.Error</div>
                    }
                    
                    <div>
                        <label asp-for="NewPassword"></label>
                        <input asp-for="NewPassword" type="password"
                               class="form-control bg-white rounded-3"
                               placeholder="Enter your password"/>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mt-3 mb-3">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" type="password"
                               class="form-control bg-white rounded-3"
                               placeholder="Confirm your password"/>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="text-center mt-1">
                        <button type="submit" class="btn btn-primary me-2">Edit Password</button>
                        <a asp-controller="Home" class="btn btn-secondary">Back to Home</a>
                    </div>
                </form>
            </div>
            <div class="col-12 col-md-3"></div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
