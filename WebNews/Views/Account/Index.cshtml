@model WebNews.Models.ViewModels.Account.AccountViewModel

@{
    ViewData["Title"] = "User Account";
}


<div class="container-fluid">
    <div class="row">
        
        <div class="col-12 col-md-3"></div>
        
        <div class="col-12 col-md-6 d-flex justify-content-center align-items-center pt-4">
            <form asp-action="Index" asp-controller="Account" enctype="multipart/form-data"
                  class="mt-3">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger rounded-3">@ViewBag.Error</div>
                }
                <div><label asp-for="Username" class="fs-4"></label>
                    <input asp-for="Username"
                           class="form-control rounded-3"/>
                    <span
                        asp-validation-for="Username" class="text-danger"></span></div>
                <div class="mt-2"><label asp-for="Email" class="fs-4"></label>
                    <input asp-for="Email"
                           class="form-control rounded-3"/>
                    <span asp-validation-for="Email" class="text-danger"></span></div>
                <div class="mt-2">
                    <span
                        class="fs-4"> Date Create: @Model.PublishDateCreate.ToString("dd.MM.yyyy") </span></div>
                <div class="d-flex justify-content-center gap-2 mt-4">
                    <button type="submit" class="btn btn-primary mt-1">Edit Data</button>
                    <a asp-controller="Home" class="btn btn-secondary mt-1">Back to Home</a></div>
            </form>
        </div>
        
        <div class="col-12 col-md-3"></div>
        
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}