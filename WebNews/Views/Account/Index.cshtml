@model WebNews.Models.ViewModels.Account.AccountViewModel

@{
    ViewData["Title"] = "User Account";
}

<div class="content-wrapper container mt-5" style="width:70%">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-light shadow-lg p-4 rounded-4">
                <form asp-action="Index" asp-controller="Account" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger rounded-3">@ViewBag.Error</div>
                    }
                    
                    <div>
                        <label asp-for="UserName"></label>
                        <input asp-for="UserName" class="form-control bg-white rounded-3"/>
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    <div class="mt-3">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control bg-white rounded-3"/>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mt-3 text-center">
                        <span class="fs-4">
                            Date Create: @Model.PublishDateCreate
                        </span>
                    </div>
                    
                    <div class="text-center mt-3">
                        <a asp-action="UpdatePassword" asp-controller="Account" class="btn btn-secondary w-100">
                            Update Password
                        </a>
                    </div>
                    
                    <div class="text-center mt-2">
                        <button type="submit" class="btn btn-primary me-2">Edit Data</button>
                        <a asp-controller="Home" class="btn btn-secondary">Back to Home</a>
                    </div>
                </form>
            </div>
            <div class="col-12 col-md-3"></div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}