<nav class="navbar navbar-expand-lg bg-light py-1" data-bs-theme="light">
    <div class="container-fluid">
        <a class="navbar-brand ms-2" href="/">
            <img class="d-inline-block" src="/logoNavbar.svg" alt="Web News" height="40">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="collapse"
                aria-controls="navbarColor02" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarColor03">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link active" href="/">Home
                        <span class="visually-hidden">(current)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="/News">News</a>
                </li>

                @if (User.IsInRole(RoleType.Admin))
                {
                    <li class="nav-item active">
                        <a class="nav-link active" href="/Admin">Admin</a>
                    </li>
                }
            </ul>
            
            <div class="navbar-center position-absolute top-50 start-50 translate-middle text-center">
                @if (ViewData["Title"] != null)
                {
                    <span class="navbar-text text-dark fw-semibold fs-4">@ViewData["Title"]</span>
                }
            </div>
            
            <ul class="navbar-nav ms-auto">
                <div class="d-flex ms-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link">Hello, @User.Identity.Name</span>
                        </li>
                    }
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item active">
                            <a class="nav-link active" href="/Auth/Register">Register</a>
                        </li>
                        <li class="nav-item active">
                            <a class="nav-link active" href="/Auth/Login">Login</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item active">
                            <a class="nav-link active" href="/Auth/Logout">Logout</a>
                        </li>
                    }
                </div>
            </ul>
        </div>
    </div>
</nav>