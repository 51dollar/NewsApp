@using WebNews.Helpers.Auth
<nav class="navbar navbar-expand-lg bg-light py-1" data-bs-theme="light">
    <div class="container-fluid">
        <a class="navbar-brand ms-2" asp-controller="Home" asp-action="Index">
            <img class="d-inline-block" src="/Image/Logo/LogoNavbar.svg" alt="Web News" height="40">
        </a>
        
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="collapse"
                aria-controls="navbarColor02" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        
        <div class="collapse navbar-collapse" id="navbarColor03">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link active" asp-controller="Home" asp-action="Index" aria-current="page">
                        Home
                    </a>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link active" asp-controller="News" asp-action="Index">
                        News
                    </a>
                </li>

                @if (User?.Identity?.IsAuthenticated == true && User.IsInRole(RoleType.Admin))
                {
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Admin" asp-action="Index">
                            Admin
                        </a>
                    </li>
                }
            </ul>

            <div class="navbar-center position-absolute top-50 start-50 translate-middle text-center">
                @if (!string.IsNullOrEmpty(ViewData["Title"] as string))
                {
                    <span class="navbar-text text-dark fw-semibold fs-4">
                        @ViewData["Title"]
                    </span>
                }
            </div>

            <ul class="navbar-nav ms-auto">
                <div class="d-flex ms-auto">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        var username = User.Identity.Name;
                        
                        <li class="nav-item">
                            @if (User.IsInRole(RoleType.User))
                            {
                                <a class="nav-link active" asp-controller="Account" asp-action="Index">
                                    Hello, @username
                                </a>
                            }
                            else
                            {
                                <span class="nav-link active">
                                    Hello, @username
                                </span>
                            }
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Auth" asp-action="Logout">
                                Logout
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Auth" asp-action="Register">
                                Register
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Auth" asp-action="Login">
                                Login
                            </a>
                        </li>
                    }
                </div>
            </ul>
        </div>
    </div>
</nav>