@model IEnumerable<News>

@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between my-4">
        <div class="flex-grow-1 text-center">
            <h2 class="mb-0">Manage News Posts</h2>
        </div>
        <div>
            <a class="btn btn-primary" asp-action="Create" asp-controller="Admin">Create New Post</a>
        </div>
    </div>

    <table class="table table-sm table-bordered table-hover text-center align-middle">
        <thead class="table-dark">
        <tr>
            <th class="p-1" style="width: 120px;">ID News</th>
            <th class="p-1" style="width: 200px;">Title</th>
            <th class="p-1" style="width: 150px;">Author</th>
            <th class="p-1" style="width: 120px;">Published</th>
            <th class="p-1" style="width: 220px;">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.PublishDateTime.ToString("dd MMM yyyy")</td>
                <td>
                    <a asp-controller="News" asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-info btn-sm me-1">
                        Details
                    </a>
                    <a asp-controller="Admin" asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm me-1">
                        Edit
                    </a>
                    <form asp-controller="Admin" asp-action="Delete" asp-route-id="@item.Id" method="post"
                          class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Are you sure you want to delete this post?')">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>