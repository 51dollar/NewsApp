@using WebNews.Helpers.UI
@model WebNews.Models.ViewModels.Admin.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container-3 mt-4">
    <div class="d-flex align-items-center justify-content-center my-4 position-relative">
        <h2 class="mb-0">Manage News</h2>
        
        <div class="position-absolute end-0">
            <a class="btn btn-primary" asp-action="Create" asp-controller="Admin">Create Post</a>
        </div>
    </div>
    
    <table class="table table-sm table-bordered table-hover text-center align-middle">
        <thead class="table-dark">
        <tr>
            <th class="p-1" style="width: 120px;">ID News</th>
            <th class="p-1" style="width: 300px;">Title</th>
            <th class="p-1" style="width: 100px;">Author</th>
            <th class="p-1" style="width: 100px;">Published</th>
            <th class="p-1" style="width: 250px;">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.NewsItems)
        {
            <tr class="table-light">
                <td>
                    @item.Id
                </td>
                <td>@(HtmlTagHelper.RemoveHtmlTags(item.Title).Length > 100
                        ? HtmlTagHelper.RemoveHtmlTags(item.Title).Substring(0, 100) + "..."
                        : HtmlTagHelper.RemoveHtmlTags(item.Title))
                </td>
                <td>
                    @item.Author
                </td>
                <td>
                    @item.PublishDateTime.ToString("dd MMM yyyy")
                </td>
                <td>
                    <a asp-controller="News" asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-info btn-sm me-1">
                        Details
                    </a>
                    <a asp-controller="Admin" asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm me-1">
                        Edit
                    </a>
                    <form asp-controller="Admin" asp-action="Delete" asp-route-id="@item.Id" method="post"
                          class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Are you sure you want to delete this post?')">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    
    <div class="d-flex align-items-center justify-content-center my-4 position-relative">
        <h2 class="mb-0">Manage Users</h2>
    </div>
    
    <table class="table table-sm table-bordered table-hover text-center align-middle">
        <thead class="table-dark">
        <tr>
            <th class="p-1" style="width: 120px;">ID Users</th>
            <th class="p-1" style="width: 200px;">Username</th>
            <th class="p-1" style="width: 200px;">Email</th>
            <th class="p-1" style="width: 120px;">Role</th>
            <th class="p-1" style="width: 120px;">Date Create</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in Model.Users)
        {
            <tr class="table-light">
                <td>
                    @user.Id
                </td>
                <td>
                    @user.Username
                </td>
                <td>
                    @user.Email
                </td>
                <td>
                    @user.Role
                </td>
                <td>
                    @user.PublishDateCreate.ToString("dd MMM yyyy")
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>