@model IEnumerable<WebNews.Models.Entities.User>

@{
    ViewData["Title"] = "All List Users";
}

<div class="container-3 mt-4">
    <table class="table table-sm table-bordered table-hover text-center align-middle">
        <thead class="table-dark">
        <tr>
            <th class="p-1" style="width: 20%;">ID Users</th>
            <th class="p-1" style="width: 15%;">Username</th>
            <th class="p-1" style="width: 20%;">Email</th>
            <th class="p-1" style="width: 15%;">Role</th>
            <th class="p-1" style="width: 15%;">Date Create</th>
            <th class="p-1" style="width: 15%;">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
            <tr class="table-light">
                <td>
                    @user.Id
                </td>
                <td>
                    @user.UserName
                </td>
                <td>
                    @user.Email
                </td>
                <td>
                    
                </td>
                <td>
                    @user.PublishDateCreate.ToString("dd MMM yyyy")
                </td>
                <td>
                    <a asp-controller="Admin" asp-action="EditRoles" asp-route-id="@user.Id"
                       class="btn btn-warning btn-sm me-1 actions-btn"
                       style="width: 100px; height: 40px; margin-top: 3px; margin-left: 3px;">
                        Add Role
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>